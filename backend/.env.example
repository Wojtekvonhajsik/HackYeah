# Skopiuj ten plik jako backend/.env i uzupełnij. Plik .env jest w .gitignore - NIE commituj kluczy.

# Token Mapillary (Client Token, zaczyna się od MLY|): https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Detektor zdjęć: mock (stałe wyniki, bez klucza) | gemini | claude
DETECTOR=mock

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude (opcjonalnie, jeśli DETECTOR=claude)
# ANTHROPIC_API_KEY=

# Frontend na produkcji (domyślnie wszystkie originy)
# CORS_ORIGINS=https://twoja-domena.pl
