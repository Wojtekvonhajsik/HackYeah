# Skopiuj ten plik jako backend/.env i uzupełnij. Plik .env jest w .gitignore - NIE commituj kluczy.

# Token Mapillary (Client Token, zaczyna się od MLY|): https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Detektor zdjęć: mock (stałe wyniki, bez klucza) | gemini | claude
DETECTOR=mock

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude (opcjonalnie, jeśli DETECTOR=claude)
# ANTHROPIC_API_KEY=

# Plik bazy SQLite (domyślnie backend/data/bezbarier.db); ":memory:" = bez zapisu na dysk
# DATABASE_PATH=

# Obszar wyszukiwania miejsc: minLon,maxLat,maxLon,minLat (domyślnie Kraków)
# CITY_VIEWBOX=19.79,50.13,20.22,49.97

# Własna instancja Overpass zamiast publicznych
# OVERPASS_URL=

# Klucz administratora: skan zdjęć (płatne API) tylko z nagłówkiem X-Admin-Token.
# Bez niego skan jest otwarty dla każdego - USTAW przed wdrożeniem publicznym.
# ADMIN_TOKEN=

# Limit głosów na godzinę z jednego adresu IP
# VOTE_RATE_LIMIT_PER_HOUR=30

# Co ile dni odświeżać dane z OpenStreetMap dla miejsca
# OSM_REFRESH_DAYS=30

# Frontend na produkcji (domyślnie wszystkie originy)
# CORS_ORIGINS=https://twoja-domena.pl

# Limit pytań do asystenta AI na godzinę z jednego adresu (każde pytanie to płatne wywołanie modelu)
# ASSISTANT_RATE_LIMIT_PER_HOUR=60
